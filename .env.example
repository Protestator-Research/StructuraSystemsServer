# Copy to .env and replace all values. .env is not committed.
# Used by docker-compose.yaml. Use long random passwords (for example: openssl rand -base64 24).
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-root
MONGO_APP_USERNAME=structura
MONGO_APP_PASSWORD=change-me-app
MONGO_EXPRESS_USERNAME=mongoexpressuser
MONGO_EXPRESS_PASSWORD=change-me-express
